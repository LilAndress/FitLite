# ========================================================
# FitLite - Variables de Entorno
# ========================================================
#
# Para activar el Coach IA con Google Gemini (100% GRATUITO sin tarjeta de crédito):
# 1. Ve a: https://aistudio.google.com/
# 2. Inicia sesión con cualquier cuenta de Google (Gmail).
# 3. Haz clic en "Get API key" -> "Create API key".
# 4. Copia tu clave y pégala abajo:
#
GEMINI_API_KEY=tu_clave_api_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Base de datos (Opcional, por defecto configurado en docker-compose.yml)
POSTGRES_USER=fitlite_user
POSTGRES_PASSWORD=fitlite_pass
POSTGRES_DB=fitlite_db
